{
  "version": "2.0",

  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },

  "functionTimeout": "00:10:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "samplingPercentage": 25 }
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "",
      "maxOutstandingRequests": 20,
      "maxConcurrentRequests": 10
    }
  }
}