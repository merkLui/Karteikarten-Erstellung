{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "authLevel": "anonymous", 
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
      "route": "{*route}"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    }
  ]
}